{
	"schemaVersion": 1,
	"id": "tnttrails",
	"version": "${version}",
	"name": "TNTtrails",
	"description": "See where your TNT shots actually go!",
	"authors": [
		"sectersion"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/tnttrails/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"sectersion.tnttrails.TNTtrails"
		],
		"client": [
			"sectersion.tnttrails.client.TNTtrailsClient"
		]
	},
	"mixins": [
		"tnttrails.mixins.json",
		{"config": "tnttrails.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}
